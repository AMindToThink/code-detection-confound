# data artifacts (regenerable; can be large)
data/*.parquet
data/repos/
# regenerable from external/CodeGPTSensor/dataset/ via scripts/15_format_hmcorp.py
# (~1.3 GB; takes ~30 min to rebuild)
data/hmcorp/
# training-run checkpoints (large; reproducible from scripts/18_*). Keep the JSON
# metrics, eval results, and JSONL telemetry tracked — they're small and load-bearing
# for the paper macros.
results/cgs/*/checkpoint-best-f1/
results/cgs/*.png
results/cgs/*.log
# secrets (never commit API keys)
.env
.env.*
# python
__pycache__/
*.pyc
.venv/
# keep results (figures/tables) tracked
# latex build intermediates (keep paper.tex, macros.tex, paper.pdf)
paper/*.aux
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz
results/train/
.agent-status.flag
wandb/
external/

